{
  "name": "@taifoon/n8n-nodes-typesafe",
  "version": "2.0.1",
  "description": "n8n community node for TypeSafe System One (Jev): ask Noul, Choice and Score questions about any item, branch on calibrated probabilities, and send low-confidence answers to human review.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "typesafe",
    "typesafe-ai",
    "jev",
    "system-one",
    "classification",
    "routing",
    "structured-output",
    "confidence",
    "human-in-the-loop",
    "approval",
    "guardrail",
    "ai-agent",
    "decision"
  ],
  "license": "MIT",
  "homepage": "https://github.com/taifoon-io/n8n-nodes-typesafe#readme",
  "author": {
    "name": "Taifoon",
    "email": "yawning.monsoon@proton.me",
    "url": "https://github.com/taifoon-io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taifoon-io/n8n-nodes-typesafe.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TaifoonTypeSafeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TaifoonTypeSafe/TaifoonTypeSafe.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.48.6",
    "eslint": "^9.39.5",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/taifoon-io/n8n-nodes-typesafe/issues"
  }
}
