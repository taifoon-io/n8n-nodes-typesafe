{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.taifoon.io/schemas/coordination/v1/verdict.json",
  "title": "VERDICT — the decision recorded once, and the receipt it composes to",
  "description": "decision.v1/v2 as the ledger writes it (the digest recomputes from kind, subject, model, answers and — v2 — input_digest), plus the RUBRIC_v1 composed verdict when the source states it. A REF verdict never produces a cheat; needs_review holds the job for the evaluator leg.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "taifoon.verdict.v1",
      "x-stage": "L",
      "x-source": "this contract",
      "description": "which canonical entity this record is; fixed per schema"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^decision-[0-9]+-[0-9a-f]{10}$",
      "x-stage": "S5",
      "x-source": "decision-<ms>-<digest[2..12]>"
    },
    "version": {
      "enum": [
        "decision.v1",
        "decision.v2"
      ],
      "x-stage": "S5",
      "x-source": "v2 pins input_digest inside the digest"
    },
    "kind": {
      "enum": [
        "pad",
        "suggest",
        "assemble",
        "ref",
        "grade",
        "study"
      ],
      "x-stage": "S5",
      "x-source": "where the layer asked the judge"
    },
    "subject": {
      "type": "object",
      "properties": {
        "chain_id": {
          "$ref": "common.json#/$defs/chain_id"
        },
        "at": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/address"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "chain_id",
        "at",
        "ref",
        "label"
      ],
      "additionalProperties": false,
      "x-stage": "S5",
      "x-source": "DecisionSubject (chainId, at, ref, label)"
    },
    "subject_id": {
      "$ref": "common.json#/$defs/bytes32",
      "x-stage": "S5",
      "x-source": "keccak256(abi.encode(\"taifoon.decision.subject.v1\", chainId, at, refBytes32(ref))) — JevDecisionLog.subjectOf"
    },
    "subject_job_key": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/job_key"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "L",
      "x-source": "the job the subject ref names, when it names one (hs_… → hs:…, bytes32 on a hook chain → hook:<chain>:…)"
    },
    "digest": {
      "$ref": "common.json#/$defs/bytes32",
      "x-stage": "S5",
      "x-source": "sha256(canonicalDecision) — the 32 bytes anchored and posted by the evaluator leg"
    },
    "input_digest": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/bytes32"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S5",
      "x-source": "sha256 of the text Jev read (inside the digest from v2)"
    },
    "answers_digest": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/bytes32"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S5",
      "x-source": "the jev.answer.v1 record of these answers"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "type": "string"
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "confidence": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "question",
          "options",
          "value",
          "probabilities",
          "confidence"
        ],
        "additionalProperties": false
      },
      "x-stage": "S5",
      "x-source": "DecisionAnswer[]"
    },
    "confidence_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "x-stage": "S5",
      "x-source": "LOWEST answer confidence × 10,000"
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "x-stage": "S5",
      "x-source": "model"
    },
    "answers_source": {
      "enum": [
        "layer",
        "caller-credential"
      ],
      "x-stage": "S5",
      "x-source": "who fetched the answers (compose two-step: caller-credential)"
    },
    "rubric": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "hash": {
          "$ref": "common.json#/$defs/bytes32"
        }
      },
      "required": [
        "version",
        "hash"
      ],
      "additionalProperties": false,
      "x-stage": "S5",
      "x-source": "RUBRIC_v1 + sha256(RUBRIC_V1) when the decision is a compose (note \"RUBRIC_v1 compose · rubric 0x…\")"
    },
    "composed": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "complete",
            "reject",
            "needs_review"
          ]
        },
        "auto": {
          "type": "boolean"
        },
        "forced": {
          "anyOf": [
            {
              "const": "hard_fail"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "receipt_hash": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/bytes32"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "verdict",
        "auto",
        "forced",
        "reasons",
        "receipt_hash"
      ],
      "additionalProperties": false,
      "x-stage": "S5",
      "x-source": "judge-compose receipt() when the source carries it; null when only the decision is at hand (recompose with judge-compose.compose(facts, answers))"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/anchor"
      },
      "x-stage": "S6",
      "x-source": "JevDecisionLog.record transaction (devnet 36927 0x1D62…9A05); coordd decision-<id>"
    },
    "source": {
      "$ref": "common.json#/$defs/source",
      "x-stage": "L",
      "x-source": "the mapper"
    }
  },
  "required": [
    "schema",
    "decision_id",
    "version",
    "kind",
    "subject",
    "subject_id",
    "subject_job_key",
    "digest",
    "input_digest",
    "answers_digest",
    "answers",
    "confidence_bps",
    "model",
    "answers_source",
    "rubric",
    "composed",
    "anchors",
    "source"
  ],
  "additionalProperties": false
}
