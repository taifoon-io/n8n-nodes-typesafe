{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.taifoon.io/schemas/coordination/v1/hire.json",
  "title": "HIRE — what was asked, of whom, on which ledger, for how much",
  "description": "The job itself: parties, task, money, deadline, and the lifecycle state it is in. One shape for an ERC-8183 job, a memo-ACP job, an extra deployment’s job, an assurance-hook job and a handshake that has no job yet.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "taifoon.hire.v1",
      "x-stage": "L",
      "x-source": "this contract",
      "description": "which canonical entity this record is; fixed per schema"
    },
    "job": {
      "$ref": "common.json#/$defs/job_ref",
      "x-stage": "S1",
      "x-source": "JobCreated.jobId / JobManager id / hook bytes32 / handshake id (src/ids.ts)"
    },
    "lane": {
      "$ref": "common.json#/$defs/lane",
      "x-stage": "S2",
      "x-source": "observatory source (erc8183 | memo-acp | hook, + deployment for extra) or handshake"
    },
    "tenant": {
      "type": [
        "string",
        "null"
      ],
      "x-stage": "S2",
      "x-source": "observatory tenant for hook jobs (layer | moonbeam)"
    },
    "buyer": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/address"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S1",
      "x-source": "JobCreated.client / hook JobFunded.buyer / handshake hirer / §2 offer client"
    },
    "seller": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/address"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S1",
      "x-source": "JobCreated.provider (ProviderSet on extra) / hook seller / handshake candidate.address"
    },
    "seller_agent_key": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/agent_key"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S9",
      "x-source": "the provider → ERC-8004 join: extra provider_agent_id, handshake candidate.agentId; null when nothing joins them (the missing seam)"
    },
    "seller_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scheme": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "scheme",
          "id"
        ],
        "additionalProperties": false
      },
      "x-stage": "S1",
      "x-source": "every other id the source names for the seller: bitagent ProviderSet agentId (not an ERC-8004 id), handshake candidate agentId"
    },
    "evaluator": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/address"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S1",
      "x-source": "JobCreated.evaluator (null for hook jobs: the buyer or the hook’s evaluators decide)"
    },
    "hook": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/address"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S1",
      "x-source": "JobCreated.hook (ERC-8183 hook contract; null when zero) / the assurance hook itself on the hook lane"
    },
    "evaluator_kind": {
      "anyOf": [
        {
          "enum": [
            "buyer",
            "none",
            "named",
            "platform",
            "hook"
          ]
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S2",
      "x-source": "observatory evaluator_kind; hook = the assurance hook’s buyer/evaluator set"
    },
    "task": {
      "type": [
        "string",
        "null"
      ],
      "x-stage": "S2",
      "x-source": "getJob(id).description (tasks.json) / memo-ACP first REQUEST memo / handshake task / §2 offer task"
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-stage": "L",
      "x-source": "handshake / offer required_skills"
    },
    "budget": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/amount"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S1",
      "x-source": "JobFunded.amount (else BudgetSet / getJob word 6) in the job token; handshake budget_usdc"
    },
    "funding": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "price": {
          "$ref": "common.json#/$defs/amount"
        },
        "premium": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "deposit": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/address"
            },
            {
              "type": "null"
            }
          ]
        },
        "cover_cap": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/uint_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/unix_s"
            },
            {
              "type": "null"
            }
          ]
        },
        "challenge_window": {
          "type": [
            "integer",
            "null"
          ],
          "description": "stored by the hook, read by no contract logic"
        }
      },
      "required": [
        "price",
        "premium",
        "deposit",
        "pool",
        "cover_cap",
        "deadline",
        "challenge_window"
      ],
      "additionalProperties": false,
      "x-stage": "S1",
      "x-source": "hook JobFunded(price, premium, deposit, pool) + JobCovered.coverCap + jobs(jobId).deadline; ERC-8183 JobFunded.amount as price"
    },
    "created_at": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/unix_s"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S1",
      "x-source": "JobCreated block ts / handshake createdAt"
    },
    "deadline": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/unix_s"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S1",
      "x-source": "JobCreated.expiredAt / hook deadline"
    },
    "handshake_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^hs_[0-9a-f]{24}$",
      "x-stage": "L",
      "x-source": "the broker’s handshake this job was offered under"
    },
    "offer_nonce": {
      "type": [
        "string",
        "null"
      ],
      "x-stage": "S7",
      "x-source": "§2 offer nonce the seller must echo (n8n.webhook class DET)"
    },
    "state": {
      "$ref": "common.json#/$defs/lifecycle_state",
      "x-stage": "L",
      "x-source": "machine state (src/machine.ts) derived from the events / hook state / memo phase / handshake state"
    },
    "ending": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/ending"
        },
        {
          "type": "null"
        }
      ],
      "x-stage": "S2",
      "x-source": "observatory ending, null for a handshake"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/anchor"
      },
      "x-stage": "S1",
      "x-source": "JobCreated / JobFunded transactions; the handshake row"
    },
    "source": {
      "$ref": "common.json#/$defs/source",
      "x-stage": "L",
      "x-source": "the mapper"
    }
  },
  "required": [
    "schema",
    "job",
    "lane",
    "tenant",
    "buyer",
    "seller",
    "seller_agent_key",
    "seller_ids",
    "evaluator",
    "hook",
    "evaluator_kind",
    "task",
    "required_skills",
    "budget",
    "funding",
    "created_at",
    "deadline",
    "handshake_id",
    "offer_nonce",
    "state",
    "ending",
    "anchors",
    "source"
  ],
  "additionalProperties": false
}
