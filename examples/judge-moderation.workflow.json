        "routing": "{\"spam\":{\"lte\":0.2},\"harassment\":{\"lte\":0.2},\"personal_data\":{\"lte\":0.2}}",
        "replyLanguage": "off",
        "failClosed": true,
        "state": "={{ JSON.stringify($json) }}"
      },
