{
  "name": "Accept or return a freelancer's deliverable (Jev judge)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Submit a deliverable for review",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Brief",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Acceptance criteria (one per line)",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Deliverable (text or link contents)",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "name": "Deliverable form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        420
      ],
      "webhookId": "deliverable-form"
    },
    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nreturn [{ pairedItem: { item: 0 }, json: {\n  ref: 'delivery-' + Date.now(),\n  task: f['Brief'],\n  criteria: String(f['Acceptance criteria (one per line)'] || '').split('\\n').map((s) => s.trim()).filter(Boolean),\n  delivered: f['Deliverable (text or link contents)'],\n  checks: { not_empty: !!String(f['Deliverable (text or link contents)'] || '').trim() },\n} }];"
      },
      "name": "The job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst criteria = j.criteria.map((c, i) => `${i + 1}. ${c}`).join('\\n');\nconst state = ['task: ' + j.task, 'acceptance criteria:\\n' + criteria, j.source ? 'source:\\n' + j.source : '', 'delivered:\\n' + (j.delivered || '(nothing was delivered)')].filter(Boolean).join('\\n\\n');\nconst checks = {};\nfor (const [name, ok] of Object.entries(j.checks || {})) checks[name] = !!ok;\nreturn [{ pairedItem: { item: 0 }, json: { ...j, state, facts: { delivered: !!(j.delivered && String(j.delivered).trim()), checks } } }];"
      },
      "name": "What the judge reads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        420
      ]
    },
    {
      "parameters": {
        "operation": "ask",
        "connection": "direct",
        "model": "jev-1.13.0",
        "questions": {},
        "questionsJson": "[]",
        "routing": "{}",
        "replyLanguage": "off",
        "failClosed": true,
        "state": "={{ $json.state }}",
        "jev": {
          "rubric": true,
          "subject": "={{ $json.ref }}",
          "factsJson": "={{ JSON.stringify($json.facts) }}"
        }
      },
      "name": "TypeSafe",
      "type": "@taifoon/n8n-nodes-typesafe.taifoonTypeSafe",
      "typeVersion": 1,
