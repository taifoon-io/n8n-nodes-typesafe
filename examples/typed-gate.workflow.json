{
  "name": "Taifoon TypeSafe — a typed gate with a stand-down branch",
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] } }, "name": "Every 5 minutes", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0], "id": "a1" },
    { "parameters": { "jsCode": "// code computes, the model judges: build the state here, with arithmetic\nreturn [{ json: { state: { trend: 'DOWN_STRONG', rsi: 24, rsi_lo: 30, rsi_hi: 70, vol_regime: 1.8, range_pos: 0.06, flow: 'SELLERS' } } }];" }, "name": "Build state", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [220, 0], "id": "a2" },
    { "parameters": { "operation": "ask", "model": "jev", "state": "={{ JSON.stringify($json.state) }}", "questions": { "question": [
        { "id": "oversold", "kind": "noul", "text": "Is rsi below rsi_lo?" },
        { "id": "toxic", "kind": "noul", "text": "Is selling flow heavy enough that a long entry would be picked off?" },
        { "id": "vol_rising", "kind": "noul", "text": "Is volatility well above its norm?" },
        { "id": "regime", "kind": "choice", "text": "Which regime is this?", "options": "trending, mean_reverting, quiet" } ] }, "failClosed": true },
      "name": "Taifoon TypeSafe", "type": "@taifoon/n8n-nodes-typesafe.taifoonTypeSafe", "typeVersion": 1, "position": [440, 0], "id": "a3", "credentials": { "taifoonGatewayApi": { "id": "1", "name": "Taifoon Gateway API" } } },
    { "parameters": { "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "combinator": "and", "conditions": [
        { "leftValue": "={{ $json.answers.oversold.p }}", "rightValue": 0.8, "operator": { "type": "number", "operation": "gt" } },
        { "leftValue": "={{ $json.answers.toxic.p }}", "rightValue": 0.4, "operator": { "type": "number", "operation": "lt" } },
        { "leftValue": "={{ $json.answers.regime.confidence }}", "rightValue": 0.6, "operator": { "type": "number", "operation": "gt" } } ] } },
      "name": "Gate: thresholds live HERE, not in the prompt", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [680, 0], "id": "a4" },
    { "parameters": {}, "name": "Act", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [920, -80], "id": "a5" },
    { "parameters": {}, "name": "Stand down", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [920, 80], "id": "a6" }
  ],
  "connections": {
    "Every 5 minutes": { "main": [[{ "node": "Build state", "type": "main", "index": 0 }]] },
    "Build state": { "main": [[{ "node": "Taifoon TypeSafe", "type": "main", "index": 0 }]] },
    "Taifoon TypeSafe": { "main": [[{ "node": "Gate: thresholds live HERE, not in the prompt", "type": "main", "index": 0 }]] },
    "Gate: thresholds live HERE, not in the prompt": { "main": [[{ "node": "Act", "type": "main", "index": 0 }], [{ "node": "Stand down", "type": "main", "index": 0 }]] }
  }
}
